# LOCAL SECRETS TEMPLATE - DO NOT COMMIT
# Copy this file to .env.local-secrets and fill in your actual credentials
# .env.local-secrets is gitignored and loaded alongside .env.local

# AWS / MinIO Credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Google OAuth
GOOGLE_OAUTH2_CLIENT_ID=
GOOGLE_OAUTH2_CLIENT_SECRET=

# AI API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
COHERE_API_KEY=
HUGGINGFACE_API_KEY=

# Email Credentials
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Secret Key (Django)
SECRET_KEY=

# Database Credentials
POSTGRES_PASSWORD=

# JWT Token Secret (if separate from SECRET_KEY)
JWT_SECRET=

# GitHub Integration
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3002/github/callback

# LinkedIn Integration
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3002/linkedin/callback
