# Deployment Configuration - dev environment
# Credentials & secrets go in .env.dev-secrets (gitignored)
DEPLOY_ENV=dev
DEPLOY_TYPE=docker

DEBUG=True
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=https://code-dev.yuvro.ai,https://hub-dev.yuvro.ai,https://backend-hub-dev.yuvro.ai,https://dev.yuvrolabs.com,http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004
CSRF_TRUSTED_ORIGINS=https://*.yuvrolabs.com,https://*.yuvro.ai

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME=15
JWT_REFRESH_TOKEN_LIFETIME=7

# Frontend URL
FRONTEND_URL=https://hub-dev.yuvro.ai

# Storage
STORAGE_BACKEND=s3
APP_NAME=yhub
AWS_S3_REGION_NAME=ap-south-1
AWS_S3_ENDPOINT_URL=
AWS_S3_ADDRESSING_STYLE=virtual
AWS_QUERYSTRING_AUTH=False
AWS_S3_PUBLIC_ENDPOINT_URL=

# Product backends
YCODE_BACKEND_URL=https://backend-code-dev.yuvro.ai
YLABS_BACKEND_URL=https://backend-dev.yuvrolabs.com

# Razorpay (non-secret test keys)
RAZORPAY_KEY_ID=rzp_test_T56EPoR3Lpa9xz
RAZORPAY_KEY_SECRET=v0jEa7ZKpypmbK2iyAY0CyIS
