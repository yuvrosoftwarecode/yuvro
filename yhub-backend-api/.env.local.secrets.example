# Deployment Configuration - local environment
# Credentials & secrets go in .env.local-secrets (gitignored)
DEPLOY_ENV=
DEPLOY_TYPE=

DEBUG=
ALLOWED_HOSTS=
CORS_ALLOWED_ORIGINS=

SECRET_KEY=

# PostgreSQL
DATABASE_URL=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME=
JWT_REFRESH_TOKEN_LIFETIME=

# Product Backends
YCODE_BACKEND_URL=
YLABS_BACKEND_URL=

# AI API Keys
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
COHERE_API_KEY=
HUGGINGFACE_API_KEY=

# GitHub Integration
GITHUB_CLIENT_ID=xxxxxx
GITHUB_CLIENT_SECRET=xxxxxxxxx
GITHUB_REDIRECT_URI=http://localhost:8003/api/auth/github/callback

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_ENABLED=true
LLM_TIMEOUT_SECONDS=20