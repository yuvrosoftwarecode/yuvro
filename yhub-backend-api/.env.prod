# Deployment Configuration - prod environment
DEPLOY_ENV=prod
DEPLOY_TYPE=kubernetes

DEBUG=False
ALLOWED_HOSTS=api.yhub.yuvro.ai,yhub.yuvro.ai
CORS_ALLOWED_ORIGINS=https://yhub.yuvro.ai
CSRF_TRUSTED_ORIGINS=https://yhub.yuvro.ai

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME=15
JWT_REFRESH_TOKEN_LIFETIME=7

# Frontend URL
FRONTEND_URL=https://yhub.yuvro.ai

# Storage
STORAGE_BACKEND=s3
APP_NAME=yhub
AWS_STORAGE_BUCKET_NAME=yuvro-prod
AWS_S3_REGION_NAME=ap-south-1
AWS_S3_ENDPOINT_URL=
AWS_S3_ADDRESSING_STYLE=virtual
AWS_QUERYSTRING_AUTH=False
AWS_S3_PUBLIC_ENDPOINT_URL=

# Product backends (production URLs)
YCODE_BACKEND_URL=https://api.ycode.yuvro.ai
YLABS_BACKEND_URL=https://api.ylabs.yuvro.ai

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True

# Security - HTTPS and HSTS
SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=1
SECURE_HSTS_PRELOAD=1

# Database
POSTGRES_DB=yhub_prod_db
POSTGRES_USER=yhub_prod_user

# Frontend Configuration
VITE_API_URL=https://api.yhub.yuvro.ai

# LLM Configuration
LLM_ENABLED=true
LLM_TIMEOUT_SECONDS=20

# Razorpay (production keys - from secrets)
RAZORPAY_KEY_ID=razorpay_prod_key_from_secrets
