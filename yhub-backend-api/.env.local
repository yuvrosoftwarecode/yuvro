# Deployment Configuration - local environment
# Credentials & secrets go in .env.local-secrets (gitignored)
DEPLOY_ENV=local
DEPLOY_TYPE=docker

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:3002,http://localhost:3000,http://localhost:3001,http://localhost:3003,http://localhost:3004
CSRF_TRUSTED_ORIGINS=http://localhost:3002,http://localhost:3000,http://localhost:3001,http://localhost:3003,http://localhost:3004

SECRET_KEY=your-strong-secret-key-change-this

# PostgreSQL
DATABASE_URL=postgresql://postgres:password@yhub-db:5432/yhub_backend_db
POSTGRES_DB=yhub_backend_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME=180
JWT_REFRESH_TOKEN_LIFETIME=7

# Frontend URL
FRONTEND_URL=http://localhost:3002


YCODE_BACKEND_URL=http://ycode-backend:8000
YLABS_BACKEND_URL=http://ylabs-backend:8000
YMARKETPLACE_BACKEND_URL=http://ymarketplace-backend:8004


EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465

EMAIL_USE_TLS=False
EMAIL_USE_SSL=True

EMAIL_HOST_USER=contact@yuvro.ai
EMAIL_HOST_PASSWORD=Yuvro@123

DEFAULT_FROM_EMAIL=contact@yuvro.ai

# S3 / MinIO Storage
STORAGE_BACKEND=s3
APP_NAME=yhub
AWS_STORAGE_BUCKET_NAME=yuvro-local
AWS_S3_REGION_NAME=ap-south-1
AWS_S3_ENDPOINT_URL=http://yuvro-minio:9000
AWS_S3_PUBLIC_ENDPOINT_URL=http://localhost:9100
AWS_S3_ADDRESSING_STYLE=path
AWS_QUERYSTRING_AUTH=False
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_ENABLED=true
LLM_TIMEOUT_SECONDS=20