# Deployment Configuration - dev environment
DEPLOY_ENV=dev
DEPLOY_TYPE=docker

# Code Executor Service Configuration
SERVICE_PORT=8009
DEBUG=false
DEFAULT_TIMEOUT=10
MAX_TIMEOUT=30
MAX_MEMORY_MB=256

# OpenTelemetry
OTEL_ENABLED=false
OTEL_SERVICE_NAME=code-executor
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_RESOURCE_ATTRIBUTES=service.name=code-executor,service.version=1.0.0

# Prometheus Metrics
PROMETHEUS_PORT=9002
