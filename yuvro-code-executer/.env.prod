# Deployment Configuration - prod environment
DEPLOY_ENV=prod
DEPLOY_TYPE=kubernetes

# Code Executor Service Configuration
SERVICE_PORT=8002
DEBUG=false
DEFAULT_TIMEOUT=10
MAX_TIMEOUT=30
MAX_MEMORY_MB=256

# OpenTelemetry (AWS X-Ray for prod)
OTEL_ENABLED=true
OTEL_SERVICE_NAME=code-executor
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_RESOURCE_ATTRIBUTES=service.name=code-executor,service.version=1.0.0,deployment.environment=prod

# Prometheus Metrics
PROMETHEUS_PORT=9002
