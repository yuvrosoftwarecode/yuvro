# YCampus Platform Makefile

COMPOSE_FILES := -f docker-compose.yuvro.yml -f docker-compose.ycampus.yml

.PHONY: setup dev dev-detached stop restart logs clean reload-data load-courses
.PHONY: db-shell db-migrate db-makemigrations db-createsuperuser db-reset
.PHONY: backend-shell backend-test backend-format backend-format-fix backend-lint backend-install
.PHONY: frontend-shell frontend-test frontend-test-watch frontend-format frontend-format-fix frontend-lint frontend-install

# ============================================================================
# Setup
# ============================================================================

setup:
	@echo "🚀 Setting up YCampus Platform..."
	@echo "Checking dependencies..."
	@command -v docker >/dev/null 2>&1 || { echo "❌ Docker is required but not installed."; exit 1; }
	@docker compose version >/dev/null 2>&1 || { echo "❌ Docker Compose is required."; exit 1; }

	@echo "Creating environment files..."
	@if [ ! -f ycampus-backend-api/.env ]; then cp ycampus-backend-api/.env.example ycampus-backend-api/.env; echo "✅ Created backend .env"; fi
	@if [ ! -f ycampus-web/.env ]; then cp ycampus-web/.env.example ycampus-web/.env; echo "✅ Created frontend .env"; fi

	@echo "Creating executor network..."
	@docker network create executor 2>/dev/null || true

	@echo "Stopping existing YCampus containers (preserving volumes)..."
	docker compose $(COMPOSE_FILES) down
	@sleep 2

	@echo "Building and starting YCampus services..."
	docker compose $(COMPOSE_FILES) up -d --build --wait

	@echo "Loading test data..."
	docker compose $(COMPOSE_FILES) exec ycampus-backend python manage.py setup_fixtures_data
	
	@echo "✅ YCampus setup complete!"
	@echo "🌐 Frontend: http://localhost:3001"
	@echo "🔧 Backend API: http://localhost:8001"

# ============================================================================
# Development
# ============================================================================

dev:
	docker compose $(COMPOSE_FILES) up --remove-orphans

dev-detached:
	docker compose $(COMPOSE_FILES) up -d --remove-orphans

stop:
	docker compose $(COMPOSE_FILES) down

restart:
	docker compose $(COMPOSE_FILES) restart

logs:
	@if [ "$(SERVICE)" = "" ]; then \
		docker compose $(COMPOSE_FILES) logs -f; \
	else \
		docker compose $(COMPOSE_FILES) logs -f $(SERVICE); \
	fi

clean:
	@echo "🧹 Cleaning YCampus containers and volumes..."
	docker compose $(COMPOSE_FILES) down -v --remove-orphans
	@echo "✅ Cleanup complete!"

reload-data:
	@echo "🔄 Reloading YCampus fixtures (no clear)..."
	docker compose $(COMPOSE_FILES) exec ycampus-backend python manage.py setup_fixtures_data
	@echo "✅ Test data reloaded!"

reload-data-clear:
	@echo "🔄 Reloading YCampus fixtures (with clear)..."
	docker compose $(COMPOSE_FILES) exec ycampus-backend python manage.py setup_fixtures_data --clear
	@echo "✅ Test data cleared and reloaded!"

reload-fixtures-data: reload-data-clear

load-fixtures-data:
	@echo "🔄 Loading YCampus fixture data (no clear)..."
	docker compose $(COMPOSE_FILES) exec ycampus-backend python manage.py setup_fixtures_data
	@echo "✅ YCampus fixture data loaded!"

load-courses:
	@echo "📚 Loading YCampus courses (dev)..."
	docker compose $(COMPOSE_FILES) exec ycampus-backend python manage.py load_courses --deploy_env dev
	@echo "✅ YCampus courses loaded!"

load-courses-prod:
	@echo "📚 Loading YCampus courses (prod)..."
	docker compose $(COMPOSE_FILES) exec ycampus-backend python manage.py load_courses --deploy_env prod
	@echo "✅ YCampus prod courses loaded!"

# ============================================================================
# Database
# ============================================================================

db-shell:
	docker compose $(COMPOSE_FILES) exec ycampus-db psql -U postgres -d yc_app

db-migrate:
	docker compose $(COMPOSE_FILES) exec ycampus-backend python manage.py migrate

db-makemigrations:
	docker compose $(COMPOSE_FILES) run --rm ycampus-backend python manage.py makemigrations

db-createsuperuser:
	docker compose $(COMPOSE_FILES) exec ycampus-backend python manage.py createsuperuser

db-reset:
	@echo "🔄 Resetting YCampus database (removing container + volume)..."
	docker compose $(COMPOSE_FILES) stop ycampus-backend ycampus-db 2>/dev/null || true
	docker compose $(COMPOSE_FILES) rm -s -f ycampus-db 2>/dev/null || true
	docker volume rm yuvro_ycampus_postgres_data 2>/dev/null || true
	@echo "🚀 Starting fresh database..."
	docker compose $(COMPOSE_FILES) up -d ycampus-db
	@echo "⏳ Waiting for database to become healthy..."
	@sleep 8
	docker compose $(COMPOSE_FILES) start ycampus-backend 2>/dev/null || \
		docker compose $(COMPOSE_FILES) up -d ycampus-backend
	@echo "✅ YCampus database reset complete!"

# ============================================================================
# Backend
# ============================================================================

backend-shell:
	docker compose $(COMPOSE_FILES) exec ycampus-backend python manage.py shell

backend-test:
	docker compose $(COMPOSE_FILES) exec ycampus-backend python manage.py test

backend-format:
	docker compose $(COMPOSE_FILES) exec ycampus-backend black . --check --diff

backend-format-fix:
	docker compose $(COMPOSE_FILES) exec ycampus-backend black .

backend-lint:
	docker compose $(COMPOSE_FILES) exec ycampus-backend flake8 .

backend-install:
	@if [ "$(PKG)" = "" ]; then \
		echo "Usage: make -f Makefile.ycampus backend-install PKG=package-name"; \
		exit 1; \
	fi
	docker compose $(COMPOSE_FILES) exec ycampus-backend pip install $(PKG)
	docker compose $(COMPOSE_FILES) exec ycampus-backend pip freeze > ycampus-backend-api/requirements.txt

# ============================================================================
# Frontend
# ============================================================================

frontend-shell:
	docker compose $(COMPOSE_FILES) exec ycampus-frontend sh

frontend-test:
	docker compose $(COMPOSE_FILES) exec ycampus-frontend npm test -- --run

frontend-test-watch:
	docker compose $(COMPOSE_FILES) exec ycampus-frontend npm test

frontend-format:
	docker compose $(COMPOSE_FILES) exec ycampus-frontend npm run format:check

frontend-format-fix:
	docker compose $(COMPOSE_FILES) exec ycampus-frontend npm run format

frontend-lint:
	docker compose $(COMPOSE_FILES) exec ycampus-frontend npm run lint

frontend-install:
	@if [ "$(PKG)" = "" ]; then \
		echo "Usage: make -f Makefile.ycampus frontend-install PKG=package-name"; \
		exit 1; \
	fi
	docker compose $(COMPOSE_FILES) exec ycampus-frontend npm install $(PKG)
