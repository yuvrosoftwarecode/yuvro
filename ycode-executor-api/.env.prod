# Deployment Configuration - prod environment
DEPLOY_ENV=prod
DEPLOY_TYPE=kubernetes

# Code Executor Service Configuration (Production)
SERVICE_PORT=8009
DEBUG=False
DEFAULT_TIMEOUT=15
MAX_TIMEOUT=60
MAX_MEMORY_MB=512

# OpenTelemetry (Production)
OTEL_ENABLED=true
OTEL_SERVICE_NAME=code-executor-prod
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.yuvro-ns.svc.cluster.local:4317
OTEL_RESOURCE_ATTRIBUTES=service.name=code-executor,service.version=1.0.0,environment=production

# Prometheus Metrics
PROMETHEUS_PORT=9002

# Security
SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=1
SECURE_HSTS_PRELOAD=1

# Allowed Hosts
ALLOWED_HOSTS=code-executor.yuvro-ns.svc.cluster.local,code-executor:8009

# Resource limits
CPU_LIMIT_CORES=2
MEMORY_LIMIT_MB=512
