# Deployment Configuration - staging environment
DEPLOY_ENV=staging
DEPLOY_TYPE=kubernetes

# Code Executor Service Configuration
SERVICE_PORT=8009
DEBUG=false
DEFAULT_TIMEOUT=10
MAX_TIMEOUT=30
MAX_MEMORY_MB=256

# OpenTelemetry (AWS X-Ray for staging)
OTEL_ENABLED=true
OTEL_SERVICE_NAME=executor-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_RESOURCE_ATTRIBUTES=service.name=code-executor,service.version=1.0.0,deployment.environment=staging

# Prometheus Metrics
PROMETHEUS_PORT=9002
