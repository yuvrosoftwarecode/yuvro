# YHub Platform Makefile

.PHONY: setup dev dev-detached stop restart logs clean
.PHONY: db-shell db-migrate db-makemigrations db-createsuperuser db-reset
.PHONY: backend-shell backend-test backend-format backend-format-fix backend-lint backend-install

# ============================================================================
# Setup
# ============================================================================

setup:
	@echo "🚀 Setting up YHub Platform..."
	@command -v docker >/dev/null 2>&1 || { echo "❌ Docker is required but not installed."; exit 1; }
	@docker compose version >/dev/null 2>&1 || { echo "❌ Docker Compose is required."; exit 1; }

	@echo "Creating environment files..."
	@if [ ! -f yhub-backend-api/.env ]; then cp yhub-backend-api/.env.example yhub-backend-api/.env; echo "✅ Created backend .env"; fi

	@echo "Creating executor network..."
	@docker network create executor 2>/dev/null || true

	@echo "Stopping existing YHub containers (preserving volumes)..."
	docker compose -f docker-compose.yhub.yml down
	@sleep 2

	@echo "Building and starting YHub services..."
	docker compose -f docker-compose.yhub.yml up -d --build --wait

	@echo "✅ YHub setup complete!"
	@echo "🔧 Backend API: http://localhost:8003"

# ============================================================================
# Development
# ============================================================================

dev:
	docker compose -f docker-compose.yhub.yml up --remove-orphans

dev-detached:
	docker compose -f docker-compose.yhub.yml up -d --remove-orphans

stop:
	docker compose -f docker-compose.yhub.yml down

restart:
	docker compose -f docker-compose.yhub.yml restart

logs:
	@if [ "$(SERVICE)" = "" ]; then \
		docker compose -f docker-compose.yhub.yml logs -f; \
	else \
		docker compose -f docker-compose.yhub.yml logs -f $(SERVICE); \
	fi

clean:
	@echo "🧹 Cleaning YHub containers and volumes..."
	docker compose -f docker-compose.yhub.yml down -v --remove-orphans
	@echo "✅ Cleanup complete!"

# ============================================================================
# Database
# ============================================================================

db-shell:
	docker compose -f docker-compose.yhub.yml exec yhub-db psql -U postgres -d yhub_backend_db

db-migrate:
	docker compose -f docker-compose.yhub.yml exec yhub-backend python manage.py migrate

db-makemigrations:
	docker compose -f docker-compose.yhub.yml run --rm yhub-backend python manage.py makemigrations

db-createsuperuser:
	docker compose -f docker-compose.yhub.yml exec yhub-backend python manage.py createsuperuser

db-reset:
	@echo "🔄 Resetting database..."
	docker compose -f docker-compose.yhub.yml down yhub-db -v
	docker compose -f docker-compose.yhub.yml up -d yhub-db
	@echo "✅ Database reset complete!"

# ============================================================================
# Backend
# ============================================================================

backend-shell:
	docker compose -f docker-compose.yhub.yml exec yhub-backend python manage.py shell

backend-test:
	docker compose -f docker-compose.yhub.yml exec yhub-backend python manage.py test

backend-format:
	docker compose -f docker-compose.yhub.yml exec yhub-backend black . --check --diff

backend-format-fix:
	docker compose -f docker-compose.yhub.yml exec yhub-backend black .

backend-lint:
	docker compose -f docker-compose.yhub.yml exec yhub-backend flake8 .

backend-install:
	@if [ "$(PKG)" = "" ]; then \
		echo "Usage: make -f Makefile.yhub backend-install PKG=package-name"; \
		exit 1; \
	fi
	docker compose -f docker-compose.yhub.yml exec yhub-backend pip install $(PKG)
	docker compose -f docker-compose.yhub.yml exec yhub-backend pip freeze > yhub-backend-api/requirements.txt
