# Deployment Configuration
DEPLOY_ENV=local
DEPLOY_TYPE=docker

DEBUG=True
SECRET_KEY=your-secret-key-here
DATABASE_URL=postgresql://postgres:password@ylabs-db:5432/ylabs_backend_db
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3002

# PostgreSQL
POSTGRES_DB=ylabs_backend_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# Google OAuth
GOOGLE_OAUTH2_CLIENT_ID=your-google-client-id
GOOGLE_OAUTH2_CLIENT_SECRET=your-google-client-secret

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME=15
JWT_REFRESH_TOKEN_LIFETIME=7

# Email
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=your_email@gmail.com

# Frontend URL (for password reset links)
FRONTEND_URL=http://localhost:3002

# Local Storage (MinIO)
STORAGE_BACKEND=s3
APP_NAME=ylabs
AWS_STORAGE_BUCKET_NAME=yuvro-local
AWS_S3_REGION_NAME=ap-south-1
AWS_S3_ENDPOINT_URL=http://yuvro-minio:9000
AWS_S3_PUBLIC_ENDPOINT_URL=http://localhost:9100
AWS_S3_ADDRESSING_STYLE=path
AWS_QUERYSTRING_AUTH=False
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
