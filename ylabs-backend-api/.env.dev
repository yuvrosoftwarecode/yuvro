# Deployment Configuration - dev environment
# Credentials & secrets go in .env.dev-secrets (gitignored)
DEPLOY_ENV=dev
DEPLOY_TYPE=docker

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,*
CORS_ALLOWED_ORIGINS=https://dev.yuvrolabs.com,http://dev.yuvrolabs.com,https://backend-dev.yuvrolabs.com,http://localhost:3002
CSRF_TRUSTED_ORIGINS=https://backend-dev.yuvrolabs.com,https://dev.yuvrolabs.com,http://localhost:8002

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME=15
JWT_REFRESH_TOKEN_LIFETIME=7

# Frontend URL
FRONTEND_URL=https://dev.yuvrolabs.com
