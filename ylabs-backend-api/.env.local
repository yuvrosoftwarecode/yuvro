# Deployment Configuration - local environment
# Credentials & secrets go in .env.local-secrets (gitignored)
DEPLOY_ENV=local
DEPLOY_TYPE=docker

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,ylabs-backend
CORS_ALLOWED_ORIGINS=http://localhost:3002

SECRET_KEY=your-strong-secret-key-change-this

# PostgreSQL
DATABASE_URL=postgresql://postgres:password@ylabs-db:5432/ylabs_backend_db
POSTGRES_DB=ylabs_backend_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME=15
JWT_REFRESH_TOKEN_LIFETIME=7

# Frontend URL
FRONTEND_URL=http://localhost:3002

# SMTP Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_HOST_USER=contact@yuvro.ai
EMAIL_HOST_PASSWORD=Yuvro@123
DEFAULT_FROM_EMAIL=contact@yuvro.ai
