# Deployment Configuration
DEPLOY_ENV=local
DEPLOY_TYPE=docker
# These are injected at build time by docker-compose build args (VITE_DEPLOY_*)
# Do NOT hardcode them here — they will override the real git values from CI/deploy scripts.
# VITE_DEPLOY_BRANCH=
# VITE_DEPLOY_COMMIT_SHA=
# VITE_DEPLOY_APP_VERSION=

VITE_BACKEND_API_BASE_URL=http://localhost:8002/api

# Google OAuth Configuration
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here
VITE_YCODE_BACKEND_API_BASE_URL=http://localhost:8000/api
