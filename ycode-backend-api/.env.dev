# Deployment Configuration - dev environment
# Credentials & secrets go in .env.dev-secrets (gitignored)
DEPLOY_ENV=dev
DEPLOY_TYPE=docker

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,*
CORS_ALLOWED_ORIGINS=https://code-dev.yuvro.ai,http://code-dev.yuvro.ai,http://localhost:3000
CSRF_TRUSTED_ORIGINS=https://backend-code-dev.yuvro.ai,https://backend-campus-dev.yuvro.ai,http://localhost:8001

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME=15
JWT_REFRESH_TOKEN_LIFETIME=7

# Code Executor
CODE_EXECUTOR_SERVICE_URL=http://yuvro-code-executor:8009

# Object Storage — AWS S3 (real). Credentials go in .env.dev-secrets.
# AWS_STORAGE_BUCKET_NAME is auto-populated by `deploy-dev-auto.sh` from
# the OpenTofu `s3.base_bucket_name` output. In local dev the value is set
# by `.env.local` (ycode-uploads / MinIO bucket).
STORAGE_BACKEND=s3
AWS_STORAGE_BUCKET_NAME=__AWS_STORAGE_BUCKET_NAME__
AWS_S3_REGION_NAME=us-east-1
# AWS_S3_ENDPOINT_URL=  # leave empty for real AWS S3
# AWS_S3_ADDRESSING_STYLE=virtual-hosted

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465

EMAIL_USE_TLS=False
EMAIL_USE_SSL=True

EMAIL_HOST_USER=contact@yuvro.ai
EMAIL_HOST_PASSWORD=Yuvro@123

DEFAULT_FROM_EMAIL=contact@yuvro.ai
