# Deployment Configuration - dev environment
# Credentials & secrets go in .env.dev-secrets (gitignored)
DEPLOY_ENV=dev
DEPLOY_TYPE=docker

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend
CORS_ALLOWED_ORIGINS=https://*.yuvrolabs.com,https://*.yuvro.ai,http://localhost:3000
CSRF_TRUSTED_ORIGINS=https://*.yuvrolabs.com,https://*.yuvro.ai

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME=15
JWT_REFRESH_TOKEN_LIFETIME=7

# Code Executor
CODE_EXECUTOR_SERVICE_URL=http://yuvro-code-executor:8009

STORAGE_BACKEND=s3
APP_NAME=ycode
AWS_STORAGE_BUCKET_NAME=yuvro-dev
AWS_S3_REGION_NAME=ap-south-1
AWS_S3_ENDPOINT_URL=
AWS_S3_ADDRESSING_STYLE=virtual
AWS_QUERYSTRING_AUTH=True
AWS_S3_PUBLIC_ENDPOINT_URL=

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465

EMAIL_USE_TLS=False
EMAIL_USE_SSL=True

EMAIL_HOST_USER=contact@yuvro.ai
EMAIL_HOST_PASSWORD=Yuvro@123

DEFAULT_FROM_EMAIL=contact@yuvro.ai
