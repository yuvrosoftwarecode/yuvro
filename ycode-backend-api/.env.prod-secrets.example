# PRODUCTION SECRETS TEMPLATE - DO NOT COMMIT
# Copy this file to .env.prod-secrets and fill in your actual production credentials
# .env.prod-secrets is gitignored and loaded alongside .env.prod

# AWS S3 Credentials (Production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Google OAuth (Production)
GOOGLE_OAUTH2_CLIENT_ID=
GOOGLE_OAUTH2_CLIENT_SECRET=

# AI API Keys (Production)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
COHERE_API_KEY=
HUGGINGFACE_API_KEY=

# Email Credentials (Production)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Secret Key (Django) - Use strong production key
SECRET_KEY=

# Database Credentials (Production RDS)
POSTGRES_PASSWORD=

# JWT Token Secret (if separate from SECRET_KEY)
JWT_SECRET=

# GitHub Container Registry Token
GITHUB_TOKEN=

# AWS Account ID (for ECR/EKS)
AWS_ACCOUNT_ID=

# AWS Region
AWS_REGION=
