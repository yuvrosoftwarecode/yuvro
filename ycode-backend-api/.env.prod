# Deployment Configuration - prod environment
DEPLOY_ENV=prod
DEPLOY_TYPE=kubernetes

DEBUG=False
SECRET_KEY=production-secret-key-change-me
DATABASE_URL=postgresql://postgres:password@ycode-db-rds-prod:5432/ycode_backend_db
ALLOWED_HOSTS=ycode.yourdomain.com,www.ycode.yourdomain.com
CORS_ALLOWED_ORIGINS=https://ycode.yourdomain.com

# PostgreSQL (AWS RDS)
POSTGRES_DB=ycode_backend_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secure-production-password-change-me

# Google OAuth
GOOGLE_OAUTH2_CLIENT_ID=your-production-google-client-id
GOOGLE_OAUTH2_CLIENT_SECRET=your-production-google-client-secret

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME=15
JWT_REFRESH_TOKEN_LIFETIME=7

# AI API Keys
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GEMINI_API_KEY=your-gemini-api-key
COHERE_API_KEY=your-cohere-api-key
HUGGINGFACE_API_KEY=your-huggingface-api-key

# Code Executor
CODE_EXECUTOR_SERVICE_URL=http://code-executor:8002

# Security
SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=1
SECURE_HSTS_PRELOAD=1
