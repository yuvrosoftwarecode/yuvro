            "type": "coding",
            "title": "Handle Division Error Using try...catch",
            "content": "Write a JavaScript program to throw a custom error when dividing a number by zero and handle it using try...catch.",
            "level": "subtopic",
            "topic_name": "Error Handling",
            "subtopic_name": "try/catch/finally",
            "difficulty": "easy",
            "marks": 5,
            "categories": [
                "skill_test"
            ],
            "test_cases_basic": [
                {
                    "input": "10 0",
                    "expected_output": "Cannot divide by zero"
                }
            ],
            "test_cases_advanced": [
                {
                    "input": "25 5",
                    "expected_output": "5"
                }
            ],
            "examples": [
                {
                    "input": "8 0",
                    "expected_output": "Cannot divide by zero",
                    "explanation": "Custom errors can be thrown using throw statement."
                }
            ],
            "inputFormat": "Two numbers.",
            "outputFormat": "Result or error message.",
            "solutions": [
                {
                    "title": "Division Error Handling",
                    "language": "javascript",
                    "code": "function divide(a, b) {\n  try {\n    if (b === 0) {\n      throw new Error('Cannot divide by zero');\n    }\n    console.log(a / b);\n  } catch (error) {\n    console.log(error.message);\n  }\n}\n\ndivide(10, 0);",
                    "complexity_analysis": "Time: O(1), Space: O(1)",
                    "is_primary": true,
                    "approach": "basic"
                }
            ],
            "hints": [
                "Use throw new Error().",
                "Catch the error using catch block."
            ],
