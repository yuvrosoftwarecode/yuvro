      "title": "Custom Exception for Age Validation",
      "content": "Create a custom exception that checks if age is less than 18 and raises an error.",
      "level": "subtopic",
      "topic_name": "File Handling & Exceptions",
      "subtopic_name": "Exception Handling",
      "difficulty": "hard",
      "marks": 15,
      "categories": [
        "skill_test"
      ],
      "test_cases_basic": [
        {
          "input": "20",
          "expected_output": "Valid Age"
        }
      ],
      "test_cases_advanced": [
        {
          "input": "15",
          "expected_output": "Age not allowed"
        }
      ],
      "examples": [
        {
          "input": "15",
          "expected_output": "Age not allowed",
          "explanation": "Custom exception triggered."
        }
      ],
      "inputFormat": "Single integer age.",
      "outputFormat": "Validation result.",
      "solutions": [
        {
          "title": "Custom Exception",
          "language": "python",
          "code": "class AgeError(Exception):\n    pass\n\ntry:\n    age = int(input())\n    if age < 18:\n        raise AgeError\n    print('Valid Age')\nexcept AgeError:\n    print('Age not allowed')",
          "complexity_analysis": "Time: O(1), Space: O(1)",
          "is_primary": true,
          "approach": "advanced"
        }
      ],
      "hints": [
        "Use class Exception."
      ]
    },
