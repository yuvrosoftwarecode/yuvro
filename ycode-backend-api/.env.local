# Deployment Configuration - local environment
# Credentials & secrets go in .env.local-secrets (gitignored)
DEPLOY_ENV=local
DEPLOY_TYPE=docker

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,ycode-backend
CORS_ALLOWED_ORIGINS=http://localhost:3000

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME=15
JWT_REFRESH_TOKEN_LIFETIME=7

# Code Executor
CODE_EXECUTOR_SERVICE_URL=http://yuvro-code-executor:8009

STORAGE_BACKEND=s3
APP_NAME=ycode
AWS_STORAGE_BUCKET_NAME=yuvro-local
AWS_S3_REGION_NAME=ap-south-1
AWS_S3_ENDPOINT_URL=http://yuvro-minio:9000
AWS_S3_PUBLIC_ENDPOINT_URL=http://localhost:9100
AWS_S3_ADDRESSING_STYLE=path
AWS_QUERYSTRING_AUTH=False
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
# AWS_S3_SIGNATURE_VERSION=s3v4

SECRET_KEY=your-strong-secret-key-change-this

# PostgreSQL
DATABASE_URL=postgresql://postgres:password@ycode-db:5432/ycode_backend_db
POSTGRES_DB=ycode_backend_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465

EMAIL_USE_TLS=False
EMAIL_USE_SSL=True

EMAIL_HOST_USER=contact@yuvro.ai
EMAIL_HOST_PASSWORD=Yuvro@123

DEFAULT_FROM_EMAIL=contact@yuvro.ai

# AI API Keys
ANTHROPIC_API_KEY=your-anthropic-api-key
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key
COHERE_API_KEY=your-cohere-api-key
HUGGINGFACE_API_KEY=your-huggingface-api-keyw