# Deployment Configuration - local environment
# Credentials & secrets go in .env.local-secrets (gitignored)
DEPLOY_ENV=local
DEPLOY_TYPE=docker

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:3000

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME=15
JWT_REFRESH_TOKEN_LIFETIME=7

# Code Executor
CODE_EXECUTOR_SERVICE_URL=http://yuvro-code-executor:8009

# Object Storage — MinIO (local S3-compatible).
# yuvro-minio is a shared service defined in docker-compose.yuvro.yml.
# The yuvro-minio-init one-shot container creates both buckets on first boot.
# Put real keys (or override the endpoint) in .env.local-secrets.
#
# AWS_S3_ENDPOINT_URL  → host the backend (inside Docker) uses to talk S3.
#                        Must use the *container* port (9000).
# AWS_S3_PUBLIC_ENDPOINT_URL → host the *browser* uses to fetch the image.
#                              Must use the *host* port (9100) in local.
#                              Falls back to AWS_S3_ENDPOINT_URL when unset.
STORAGE_BACKEND=s3
AWS_STORAGE_BUCKET_NAME=ycode-uploads
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=http://yuvro-minio:9000
AWS_S3_PUBLIC_ENDPOINT_URL=http://localhost:9100
AWS_S3_ADDRESSING_STYLE=path
# Use unsigned (public) URLs so the file URL fits in Profile.profile_image
# (URLField max_length=200). Buckets are configured with anonymous download
# (see yuvro-minio-init in docker-compose.yuvro.yml), so unsigned GETs work.
AWS_QUERYSTRING_AUTH=False
# AWS_S3_SIGNATURE_VERSION=s3v4

SECRET_KEY=your-strong-secret-key-change-this

# PostgreSQL
DATABASE_URL=postgresql://postgres:password@ycode-db:5432/ycode_backend_db
POSTGRES_DB=ycode_backend_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465

EMAIL_USE_TLS=False
EMAIL_USE_SSL=True

EMAIL_HOST_USER=contact@yuvro.ai
EMAIL_HOST_PASSWORD=Yuvro@123

DEFAULT_FROM_EMAIL=contact@yuvro.ai
