# YCode Platform Makefile

# Compose files used by every target in this makefile. The yuvro project is
# included because it owns the shared `yuvro-minio` service and the
# `yuvro-storage` network that the ycode backend attaches to.
COMPOSE_FILES := -f docker-compose.yuvro.yml -f docker-compose.ycode.yml

.PHONY: setup dev dev-detached stop restart logs clean reload-data load-courses
.PHONY: db-shell db-migrate db-makemigrations db-createsuperuser db-reset
.PHONY: backend-shell backend-test backend-format backend-format-fix backend-lint backend-install
.PHONY: frontend-shell frontend-test frontend-test-watch frontend-format frontend-format-fix frontend-lint frontend-install

# ============================================================================
# Setup
# ============================================================================

setup:
	@echo "🚀 Setting up YCode Platform..."
	@echo "Checking dependencies..."
	@command -v docker >/dev/null 2>&1 || { echo "❌ Docker is required but not installed."; exit 1; }
	@docker compose version >/dev/null 2>&1 || { echo "❌ Docker Compose is required."; exit 1; }

	@echo "Creating environment files..."
	@if [ ! -f ycode-backend-api/.env ]; then cp ycode-backend-api/.env.example ycode-backend-api/.env; echo "✅ Created backend .env"; fi
	@if [ ! -f ycode-web/.env ]; then cp ycode-web/.env.example ycode-web/.env; echo "✅ Created frontend .env"; fi

	@echo "Creating executor network..."
	@docker network create executor 2>/dev/null || true

	@echo "Stopping existing YCode containers (preserving volumes)..."
	docker compose $(COMPOSE_FILES) down
	@sleep 2

	@echo "Building and starting YCode services..."
	docker compose $(COMPOSE_FILES) up -d --build --wait

	@echo "Loading test data..."
	docker compose $(COMPOSE_FILES) exec ycode-backend python manage.py setup_fixtures_data
	
	@echo "✅ YCode setup complete!"
	@echo "🌐 Frontend: http://localhost:3000"
	@echo "🔧 Backend API: http://localhost:8000"

# ============================================================================
# Development
# ============================================================================

dev:
	docker compose $(COMPOSE_FILES) up --remove-orphans

dev-detached:
	docker compose $(COMPOSE_FILES) up -d --remove-orphans

stop:
	docker compose $(COMPOSE_FILES) down

restart:
	docker compose $(COMPOSE_FILES) restart

logs:
	@if [ "$(SERVICE)" = "" ]; then \
		docker compose $(COMPOSE_FILES) logs -f; \
	else \
		docker compose $(COMPOSE_FILES) logs -f $(SERVICE); \
	fi

clean:
	@echo "🧹 Cleaning YCode containers and volumes..."
	docker compose $(COMPOSE_FILES) down -v --remove-orphans
	@echo "✅ Cleanup complete!"

reload-data:
	@echo "🔄 Reloading YCode fixtures (no clear)..."
	docker compose $(COMPOSE_FILES) exec ycode-backend python manage.py setup_fixtures_data
	@echo "✅ Test data reloaded!"

reload-data-clear:
	@echo "🔄 Reloading YCode fixtures (with clear)..."
	docker compose $(COMPOSE_FILES) exec ycode-backend python manage.py setup_fixtures_data --clear
	@echo "✅ Test data cleared and reloaded!"

load-fixtures-data:
	@echo "🔄 Loading YCode fixture data (no clear)..."
	docker compose $(COMPOSE_FILES) exec ycode-backend python manage.py setup_fixtures_data
	@echo "✅ YCode fixture data loaded!"

load-courses:
	@echo "📚 Loading YCode courses (dev)..."
	docker compose $(COMPOSE_FILES) exec ycode-backend python manage.py load_courses --deploy_env dev
	@echo "✅ YCode courses loaded!"

load-courses-prod:
	@echo "📚 Loading YCode courses (prod)..."
	docker compose $(COMPOSE_FILES) exec ycode-backend python manage.py load_courses --deploy_env prod
	@echo "✅ YCode prod courses loaded!"

# ============================================================================
# Database
# ============================================================================

db-shell:
	docker compose $(COMPOSE_FILES) exec ycode-db psql -U postgres -d ycode_backend_db

db-migrate:
	docker compose $(COMPOSE_FILES) exec ycode-backend python manage.py migrate

db-makemigrations:
	docker compose $(COMPOSE_FILES) exec ycode-backend python manage.py makemigrations

db-createsuperuser:
	docker compose $(COMPOSE_FILES) exec ycode-backend python manage.py createsuperuser

db-reset:
	@echo "🔄 Resetting database..."
	docker compose $(COMPOSE_FILES) down ycode-db -v
	docker compose $(COMPOSE_FILES) up -d ycode-db
	@echo "✅ Database reset complete!"

# ============================================================================
# Backend
# ============================================================================

backend-shell:
	docker compose $(COMPOSE_FILES) exec ycode-backend python manage.py shell

backend-test:
	docker compose $(COMPOSE_FILES) exec ycode-backend python manage.py test

backend-format:
	docker compose $(COMPOSE_FILES) exec ycode-backend black . --check --diff

backend-format-fix:
	docker compose $(COMPOSE_FILES) exec ycode-backend black .

backend-lint:
	docker compose $(COMPOSE_FILES) exec ycode-backend flake8 .

backend-install:
	@if [ "$(PKG)" = "" ]; then \
		echo "Usage: make -f Makefile.ycode backend-install PKG=package-name"; \
		exit 1; \
	fi
	docker compose $(COMPOSE_FILES) exec ycode-backend pip install $(PKG)
	docker compose $(COMPOSE_FILES) exec ycode-backend pip freeze > ycode-backend-api/requirements.txt

# ============================================================================
# Frontend
# ============================================================================

frontend-shell:
	docker compose $(COMPOSE_FILES) exec ycode-frontend sh

frontend-test:
	docker compose $(COMPOSE_FILES) exec ycode-frontend npm test -- --run

frontend-test-watch:
	docker compose $(COMPOSE_FILES) exec ycode-frontend npm test

frontend-format:
	docker compose $(COMPOSE_FILES) exec ycode-frontend npm run format:check

frontend-format-fix:
	docker compose $(COMPOSE_FILES) exec ycode-frontend npm run format

frontend-lint:
	docker compose $(COMPOSE_FILES) exec ycode-frontend npm run lint

frontend-install:
	@if [ "$(PKG)" = "" ]; then \
		echo "Usage: make -f Makefile.ycode frontend-install PKG=package-name"; \
		exit 1; \
	fi
	docker compose $(COMPOSE_FILES) exec ycode-frontend npm install $(PKG)
