# Deployment Configuration - staging environment
DEPLOY_ENV=staging
DEPLOY_TYPE=kubernetes

DEBUG=False
SECRET_KEY=staging-secret-key-change-me
DATABASE_URL=postgresql://postgres:password@ycampus-db-rds-staging:5432/ycampus_backend_db
ALLOWED_HOSTS=staging.ycampus.yourdomain.com
CORS_ALLOWED_ORIGINS=https://staging.ycampus.yourdomain.com

# PostgreSQL (AWS RDS)
POSTGRES_DB=ycampus_backend_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=staging-password-change-me

# Google OAuth
GOOGLE_OAUTH2_CLIENT_ID=your-google-client-id
GOOGLE_OAUTH2_CLIENT_SECRET=your-google-client-secret

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME=15
JWT_REFRESH_TOKEN_LIFETIME=7

# AI API Keys
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GEMINI_API_KEY=your-gemini-api-key
COHERE_API_KEY=your-cohere-api-key
HUGGINGFACE_API_KEY=your-huggingface-api-key

# Code Executor
CODE_EXECUTOR_SERVICE_URL=http://code-executor:8002

# Security
SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=31536000
