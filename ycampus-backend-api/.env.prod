# Deployment Configuration - prod environment
DEPLOY_ENV=prod
DEPLOY_TYPE=kubernetes

DEBUG=False
ALLOWED_HOSTS=ycampus.yuvro.ai,www.ycampus.yuvro.ai,api.ycampus.yuvro.ai
CORS_ALLOWED_ORIGINS=https://ycampus.yuvro.ai,https://www.ycampus.yuvro.ai
CSRF_TRUSTED_ORIGINS=https://ycampus.yuvro.ai,https://www.ycampus.yuvro.ai

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME=15
JWT_REFRESH_TOKEN_LIFETIME=7

# Code Executor
CODE_EXECUTOR_SERVICE_URL=http://code-executor:8009

# Storage Configuration
STORAGE_BACKEND=s3
APP_NAME=ycampus
AWS_STORAGE_BUCKET_NAME=yuvro-prod
AWS_S3_REGION_NAME=ap-south-1
AWS_S3_ENDPOINT_URL=
AWS_S3_ADDRESSING_STYLE=virtual
AWS_QUERYSTRING_AUTH=True
AWS_S3_PUBLIC_ENDPOINT_URL=

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True

# Security - HTTPS and HSTS
SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=1
SECURE_HSTS_PRELOAD=1

# Database
POSTGRES_DB=ycampus_prod_db
POSTGRES_USER=ycampus_prod_user

# Frontend Configuration
VITE_API_URL=https://api.ycampus.yuvro.ai
VITE_CODE_EXECUTOR_URL=http://code-executor.yuvro-ns.svc.cluster.local:8009
