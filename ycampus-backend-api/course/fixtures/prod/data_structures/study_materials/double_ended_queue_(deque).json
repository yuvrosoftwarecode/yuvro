          "question": "Insert Front",
          "answer": "Add an element at the front."
        },
        {
          "question": "Insert Rear",
          "answer": "Add an element at the rear."
        },
        {
          "question": "Delete Front",
          "answer": "Remove an element from the front."
        },
        {
          "question": "Delete Rear",
          "answer": "Remove an element from the rear."
        },
        {
          "question": "Get Front",
          "answer": "View the first element."
        },
        {
          "question": "Get Rear",
          "answer": "View the last element."
        }
      ]
    },

    {
      "type": "heading",
      "content": "Insert Front Operation"
    },

    {
      "type": "paragraph",
      "content": "<p>Insert Front places a new element at the beginning of the Deque.</p>"
    },

    {
      "type": "diagram",
      "title": "Insert Front Example",
      "steps": ["[20] [30] [40]", "Insert 10", "[10] [20] [30] [40]"]
    },

    {
      "type": "process_flow",
      "title": "Insert Front Workflow",
      "steps": [
        "Check Space",
        "Move Front Pointer",
        "Insert Element",
        "Update Deque"
      ]
    },

    {
      "type": "complexity-card",
      "title": "Insert Front Complexity",
      "time_complexity": "O(1)",
      "space_complexity": "O(1)"
    },

    {
      "type": "heading",
      "content": "Insert Rear Operation"
    },

    {
      "type": "paragraph",
      "content": "<p>Insert Rear behaves similarly to enqueue in a Queue.</p>"
    },

    {
      "type": "diagram",
      "title": "Insert Rear Example",
      "steps": ["[10] [20] [30]", "Insert 40", "[10] [20] [30] [40]"]
