      "space_complexity": "O(1)"
    },

    {
      "type": "heading",
      "content": "Delete Front Operation"
    },

    {
      "type": "paragraph",
      "content": "<p>Delete Front removes the element located at the front end.</p>"
    },

    {
      "type": "diagram",
      "title": "Delete Front Example",
      "steps": ["[10] [20] [30]", "Remove 10", "[20] [30]"]
    },

    {
      "type": "complexity-card",
      "title": "Delete Front Complexity",
      "time_complexity": "O(1)",
      "space_complexity": "O(1)"
    },

    {
      "type": "heading",
      "content": "Delete Rear Operation"
    },

    {
      "type": "paragraph",
      "content": "<p>Delete Rear removes the last element stored in the Deque.</p>"
    },

    {
      "type": "diagram",
      "title": "Delete Rear Example",
      "steps": ["[10] [20] [30]", "Remove 30", "[10] [20]"]
    },

    {
      "type": "complexity-card",
      "title": "Delete Rear Complexity",
