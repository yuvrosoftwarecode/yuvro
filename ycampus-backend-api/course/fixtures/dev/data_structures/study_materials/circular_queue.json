    },

    {
      "type": "quiz",
      "question": "Which operator is commonly used for circular indexing?",
      "options": ["+", "-", "*", "%"],
      "answer": "%"
    },

    {
      "type": "quiz",
      "question": "When is a Circular Queue considered full?",
      "options": [
        "Front == Rear",
        "(Rear + 1) % Capacity == Front",
        "Front == -1",
        "Rear == Capacity"
      ],
      "answer": "(Rear + 1) % Capacity == Front"
    }
  ]
}
