# Deployment Configuration - dev environment
# Credentials & secrets go in .env.dev-secrets (gitignored)
DEPLOY_ENV=dev
DEPLOY_TYPE=docker

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,*
CORS_ALLOWED_ORIGINS=https://campus-dev.yuvro.ai,http://campus-dev.yuvro.ai,https://backend-campus-dev.yuvro.ai,http://localhost:3001,http://localhost:3002
CSRF_TRUSTED_ORIGINS=https://backend-campus-dev.yuvro.ai,https://campus-dev.yuvro.ai,http://localhost:8001

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME=15
JWT_REFRESH_TOKEN_LIFETIME=7

# Code Executor
CODE_EXECUTOR_SERVICE_URL=http://yuvro-code-executor:8009

# Object Storage — AWS S3 (real). Credentials go in .env.dev-secrets.
STORAGE_BACKEND=s3
AWS_STORAGE_BUCKET_NAME=ycampus-uploads-dev
AWS_S3_REGION_NAME=us-east-1
# AWS_S3_ENDPOINT_URL=  # leave empty for real AWS S3
# AWS_S3_ADDRESSING_STYLE=virtual-hosted
